#!/usr/bin/env node
/**
 * shipkit — a thin translator to `dagger call` (ADR 0009).
 *
 * This file must contain NO pipeline logic. Only three things belong here:
 *   1. argument translation
 *   2. output formatting
 *   3. exit-code mapping
 * If a change is none of those, it belongs in the Dagger module.
 *
 * Escape hatches, permanent:
 *   shipkit --explain <cmd>   print the dagger call and exit
 *   shipkit --raw <args...>   pass through to `dagger call`; only the module is added
 */
import { spawn, spawnSync } from "node:child_process"
import { mkdirSync, writeFileSync, existsSync, readFileSync, readdirSync } from "node:fs"
import { dirname, join } from "node:path"
import {
  COMMAND_OPTIONS,
  EXIT,
  commandKey,
  expandSecretsFile,
  isDirty,
  namesModule,
  newestMigrationId,
  parseArgs,
  parseDefaultBranch,
  rawCallArgs,
  resolveModule,
  translate,
  validateOptions,
} from "./lib.mjs"
import { parseJobResults, renderSummary } from "./summary.mjs"

const USAGE = `
shipkit — CI/CD for turnkey client projects

  shipkit ci [--stage <name>]        pre -> build -> test -> db -> push
    [--migration-base <id>]          diff base (default: newest migration on origin/<defaultBranch>)
  shipkit db lint                    Squawk on pending migrations only
  shipkit db pending                 migrations not on the default branch
  shipkit deploy --plan              what would happen; changes nothing
  shipkit deploy --yes=<token>       execute exactly that plan
                                     backup -> migrate -> release -> verify -> rollback -> clean
  shipkit backup [--out <path>]      a dump proven restorable, written to disk
  shipkit rollback <sha>
  shipkit doctor                     dagger? docker? shipkit.yaml? project?
  shipkit summary <dir>              one markdown table from the reports under <dir>
    [--jobs <file>]                  GitHub's toJSON(needs): a failed job fails the verdict

Options (an option a command does not take is an error, never ignored)
  --json            emit the raw report instead of a rendered table
  --report <path>   also write the raw report here, for \`shipkit summary\` to collect
  --sha <sha>       commit being built (default: git rev-parse HEAD)
  --branch <name>   branch being built; only the default branch publishes. On GitHub
                    Actions only a push event publishes, whatever --branch says
  --env <name>      deploy target (default: prod)
  --explain         print the underlying \`dagger call\` and exit
  --module <ref>    shipkit module to call; default: the "kit:" line in shipkit.yaml
  --raw <args...>   pass the rest to \`dagger call\` as-is; the module is still resolved
                    from --module / SHIPKIT_MODULE / kit: unless the args name one

Options for deploy
  --ssh-key <path>  private key for the target (or SHIPKIT_SSH_KEY)

Environment
  SHIPKIT_REGISTRY_TOKEN   registry credential
  SHIPKIT_SSH_KEY          path to the deploy key
  SHIPKIT_DATABASE_URL     production connection string, used by the migration bundle
  All are read by the engine and never passed as arguments.

Exit codes
  0 ok   1 gate said no   2 config   3 infrastructure   4 confirmation required
  5 not implemented in this version
`

function gitSha() {
  // On a pull request GITHUB_SHA is the merge commit, which is not what gets deployed.
  // The head SHA is, and it is what /health must report for `verify` to pass.
  if (process.env.GITHUB_EVENT_NAME === "pull_request" && process.env.GITHUB_HEAD_REF) {
    const r = spawnSync("git", ["rev-parse", "HEAD^2"], { encoding: "utf8" })
    if (r.status === 0) return r.stdout.trim()
  }
  const r = spawnSync("git", ["rev-parse", "HEAD"], { encoding: "utf8" })
  return r.status === 0 ? r.stdout.trim() : "dev"
}

/**
 * The checked-out branch, for runs outside GitHub Actions. On Actions the branch comes from the
 * event instead (publishBranch in lib.mjs): GITHUB_HEAD_REF is named by the pull request's author.
 */
function gitBranch() {
  const r = spawnSync("git", ["rev-parse", "--abbrev-ref", "HEAD"], { encoding: "utf8" })
  return r.status === 0 ? r.stdout.trim() : undefined
}

/** Uncommitted changes in the working tree. Not a git repository counts as clean: nothing to compare. */
function workingTreeDirty() {
  const r = spawnSync("git", ["status", "--porcelain", "--untracked-files=all", "--", "."], { encoding: "utf8" })
  return r.status === 0 && isDirty(r.stdout)
}

/** The name in the nearest dagger.json at or above the working directory, if any. */
function localModuleName() {
  let dir = process.cwd()
  for (;;) {
    const file = join(dir, "dagger.json")
    if (existsSync(file)) {
      try {
        return JSON.parse(readFileSync(file, "utf8")).name
      } catch {
        return undefined
      }
    }
    const parent = dirname(dir)
    if (parent === dir) return undefined
    dir = parent
  }
}

function readShipkitYaml() {
  try {
    return readFileSync("shipkit.yaml", "utf8")
  } catch {
    return undefined
  }
}

/**
 * The newest migration id that already exists on the default branch — the diff base (decision
 * D4), so a pull request is linted on what it adds rather than on every migration ever written.
 *
 * This is a git SHA translated into a migration id, which is the wrapper's job. It is NOT a
 * git SHA passed through: `dotnet ef migrations script <git-sha>` fails with "migration not
 * found", which is exactly the bug this replaced.
 *
 * Migration ids are a 14-digit timestamp followed by a name. That convention is the kit's,
 * shared with the module's own list parser — EF, Prisma and Drizzle all follow it — so
 * reading it here is not stack knowledge leaking into the wrapper.
 *
 * The branch is `defaultBranch` from shipkit.yaml, not a hardcoded `main` (#4).
 *
 * Returns undefined when there is no such remote branch, no merge base, or no migrations yet.
 * The module treats that as "lint everything", which is the safe direction, and says so.
 */
function migrationBase(yamlText) {
  const branch = parseDefaultBranch(yamlText ?? "")
  const base = spawnSync("git", ["merge-base", "HEAD", `origin/${branch}`], { encoding: "utf8" })
  if (base.status !== 0) return undefined

  const tree = spawnSync("git", ["ls-tree", "-r", "--name-only", base.stdout.trim()], {
    encoding: "utf8",
    maxBuffer: 32 * 1024 * 1024,
  })
  if (tree.status !== 0) return undefined

  return newestMigrationId(tree.stdout)
}

function daggerAvailable() {
  return spawnSync("dagger", ["version"], { stdio: "ignore" }).status === 0
}

function run(args, { json }) {
  return new Promise((resolve) => {
    // Dagger prints its own progress to stderr; the function's return value lands on stdout.
    const child = spawn("dagger", ["call", ...args], {
      stdio: ["ignore", "pipe", json ? "ignore" : "inherit"],
    })
    let out = ""
    child.stdout.on("data", (d) => (out += d))
    child.on("error", () => resolve({ status: EXIT.INFRA, out: "" }))
    child.on("close", (code) => resolve({ status: code, out }))
  })
}

/** Writes the full report to .shipkit/runs and returns its path, relative to the working directory. */
function record(report) {
  try {
    const dir = join(".shipkit", "runs")
    mkdirSync(dir, { recursive: true })
    const stamp = new Date().toISOString().replace(/[:.]/g, "-")
    const file = join(dir, `${stamp}-${(report.sha || "dev").slice(0, 7)}.json`)
    writeFileSync(file, JSON.stringify(report, null, 2))
    return file
  } catch {
    // Never fail a run because the log could not be written.
    return undefined
  }
}

/**
 * Every report file under `dir`, at any depth — `actions/download-artifact` puts each artifact
 * in a directory of its own.
 *
 * A file that is not a report is skipped rather than fatal: the summary is the last thing a
 * failed run has left, and it must not fail too.
 */
function collectReports(dir) {
  let entries
  try {
    entries = readdirSync(dir, { recursive: true, withFileTypes: true })
  } catch {
    return []
  }

  const reports = []
  for (const entry of entries) {
    if (!entry.isFile() || !entry.name.endsWith(".json")) continue
    try {
      const report = JSON.parse(readFileSync(join(entry.parentPath ?? dir, entry.name), "utf8"))
      if (Array.isArray(report.stages)) reports.push(report)
    } catch {
      // Not a report. Nothing to say about it.
    }
  }
  return reports
}

const ICON = { ok: "+", failed: "x", skipped: "-" }

function render(report, logPath) {
  const lines = []
  for (const s of report.stages ?? []) {
    const t = s.seconds != null ? `${s.seconds}s` : ""
    const why = s.reason && s.status !== "ok" ? `  ${s.reason}` : ""
    const detail = [
      s.tag ? `tag=${s.tag}` : "",
      s.tests ? `${s.tests.passed}/${s.tests.total} passed` : "",
      s.base !== undefined ? `base=${s.base}` : "",
      Array.isArray(s.pending) && s.pending.length ? `${s.pending.length} pending` : "",
    ]
      .filter(Boolean)
      .join("  ")
    lines.push(
      `  ${ICON[s.status] ?? "?"} ${s.name.padEnd(8)} ${t.padStart(6)}  ${detail}${why}`.trimEnd(),
    )
    if (s.command) lines.push(`      $ ${s.command}`)
    if (s.diagnostics) {
      const d = s.diagnostics
      const codes = Object.entries(d.codes).map(([c, n]) => `${c} ${n}`).join(", ")
      lines.push(
        `      ${d.errors} error(s), ${d.warnings} warning(s) in ${d.files.length} file(s)  [${codes}]`,
      )
      for (const f of d.files.slice(0, 15)) lines.push(`        ${String(f.count).padStart(4)}  ${f.path}`)
      if (d.files.length > 15) lines.push(`        ... ${d.files.length - 15} more file(s)`)
    }
    if (s.omitted) lines.push(`      ... ${s.omitted} earlier line(s) not shown${logPath ? `; full output in ${logPath}` : ""}`)
    for (const line of s.output ?? []) lines.push(`      ${line}`)
    for (const f of s.findings ?? []) {
      const where = f.migration
        ? `${f.migration}${f.line ? `  (script line ${f.line})` : ""}`
        : f.line ? `${f.file ?? ""}:${f.line}` : (f.file ?? "")
      lines.push(`      ${f.rule}${where ? `  ${where}` : ""}`)
      if (f.sql) lines.push(`        ${f.sql}`)
      else if (f.message) lines.push(`        ${f.message}`)
    }
  }
  if (report.rendered) lines.push("", report.rendered)
  if (report.plan && !report.rendered) lines.push("", `  plan token: ${report.plan.token}`)
  if (report.checks) {
    for (const [k, v] of Object.entries(report.checks)) {
      // MISMATCH is a failure too; it used to render with the same "+" as a pass.
      const mark = /^(MISSING|MISMATCH)/.test(v) ? "x" : v.startsWith("WARN") ? "!" : "+"
      lines.push(`  ${mark} ${k.padEnd(14)} ${v}`)
    }
  }
  if (report.pending) {
    lines.push(`  pending: ${report.pending.length ? report.pending.join(", ") : "none"}`)
  }
  if (report.dirty) {
    lines.push("", "  ! the source has uncommitted changes: an image built from it is tagged -dirty and never published")
  }
  lines.push("")
  lines.push(report.ok ? `  ok  (${report.seconds}s)` : `  FAILED  ${report.error ?? ""}`)
  if (report.next) lines.push(`  next: ${report.next}`)
  return lines.join("\n")
}

async function main() {
  const argv = process.argv.slice(2)
  if (argv.length === 0 || argv[0] === "--help" || argv[0] === "-h") {
    process.stdout.write(USAGE)
    process.exit(EXIT.OK)
  }

  const opts = parseArgs(argv)
  const yamlText = readShipkitYaml()

  const fail = (code, message) => {
    process.stderr.write(`${message}\n`)
    process.exit(code)
  }

  const mod = resolveModule({
    option: typeof opts.module === "string" ? opts.module : undefined,
    envVar: process.env.SHIPKIT_MODULE,
    yamlText,
    localModule: localModuleName(),
  })

  // Escape hatch: the rest goes to `dagger call` as-is. Only the module is added, resolved
  // exactly as for every other command — otherwise the hatch works inside this repository
  // and nowhere a client would actually need it (#3).
  if (opts.raw) {
    if (mod.error && !namesModule(opts.raw)) fail(EXIT.CONFIG, mod.error)
    const args = rawCallArgs(opts.raw, mod.ref)
    if (opts.explain) {
      process.stdout.write(`dagger ${args.join(" ")}\n`)
      process.exit(EXIT.OK)
    }
    const child = spawn("dagger", args, { stdio: "inherit" })
    child.on("error", () => process.exit(EXIT.INFRA))
    child.on("close", (c) => process.exit(c ?? EXIT.INFRA))
    return
  }

  const key = commandKey(opts._)
  if (!(key in COMMAND_OPTIONS)) {
    process.stderr.write(`unknown command: ${opts._.join(" ") || "(none)"}\n${USAGE}`)
    process.exit(EXIT.CONFIG)
  }
  const invalid = validateOptions(key, opts)
  if (invalid) fail(invalid.code, invalid.message)

  // `summary` reads files and prints markdown. It calls no module and reaches no engine, so it
  // runs before module resolution — a broken `kit:` line must not stop a run explaining itself.
  if (key === "summary") {
    const dir = opts._[1]
    if (!dir) fail(EXIT.CONFIG, "summary needs a directory of report files\n  shipkit summary ./reports")
    const title = typeof opts.title === "string" ? opts.title : "CI"
    // GitHub's `needs` results, so a job that failed without writing a report still fails the
    // verdict. Unreadable counts as failed: the summary must not say ok about what it cannot see.
    let jobs
    if (typeof opts.jobs === "string") {
      try {
        jobs = parseJobResults(readFileSync(opts.jobs, "utf8"))
      } catch {
        jobs = null
      }
    }
    process.stdout.write(renderSummary(collectReports(dir), { title, jobs }))
    // Always 0: this command reports a verdict, it does not reach one. The jobs that ran the
    // stages already failed the run; exiting non-zero here would only hide their reasons.
    process.exit(EXIT.OK)
  }

  // A deploy builds its migration bundle from the working tree while releasing the image of a
  // commit. With uncommitted changes the two would be different code (#6).
  if (key === "deploy" && typeof opts.yes === "string" && workingTreeDirty()) {
    fail(
      EXIT.CONFIG,
      "refusing to deploy from a working tree with uncommitted changes\n" +
        "  commit or stash them; the migrations would come from files the released image does not contain",
    )
  }

  // Kamal reads .kamal/secrets, whose values are references to environment variables — and the
  // container the kit runs Kamal in has none of them, so every reference used to resolve to an
  // empty string and deploy as one (#19). Resolved here, where the environment is, and refused
  // here when something has nothing behind it: before the server is touched, not after the
  // database accessory has booted without a password.
  if (key === "deploy" && typeof opts.yes === "string") {
    const secretsPath = join(".kamal", "secrets")
    if (existsSync(secretsPath)) {
      const resolved = expandSecretsFile(readFileSync(secretsPath, "utf8"), process.env)
      if (resolved.missing) {
        fail(
          EXIT.CONFIG,
          `.kamal/secrets refers to variables with no value: ${resolved.missing.join(", ")}\n` +
            "  export them where the deploy runs; an empty secret deploys and misbehaves in production",
        )
      }
      process.env.SHIPKIT_KAMAL_SECRETS = resolved.content
    }
  }

  const args = translate(key, opts, {
    sha: gitSha,
    branch: gitBranch,
    migrationBase: () => migrationBase(yamlText),
    dirty: workingTreeDirty,
    env: process.env,
  })

  if (args === null) {
    if (key === "rollback") {
      fail(
        EXIT.CONFIG,
        "rollback needs the version to put back\n" +
          "  shipkit rollback sha-<commit>  — `shipkit deploy --plan` shows what is serving now",
      )
    }
    fail(
      EXIT.CONFIRM,
      "deploy needs either --plan or --yes=<token>\n" +
        "  run `shipkit deploy --plan`, show the plan, then `shipkit deploy --yes=<token>`",
    )
  }

  if (mod.error) fail(EXIT.CONFIG, mod.error)
  if (mod.ref) args.unshift("-m", mod.ref)

  if (opts.explain) {
    process.stdout.write(`dagger call ${args.join(" ")}\n`)
    process.exit(EXIT.OK)
  }

  if (!daggerAvailable()) {
    process.stderr.write(
      "dagger is not installed or not on PATH\n" +
        "  install the version .github/actions/setup/action.yml pins, from https://docs.dagger.io/install\n",
    )
    process.exit(EXIT.INFRA)
  }

  const { status, out } = await run(args, { json: !!opts.json })

  let report
  try {
    report = JSON.parse(out)
  } catch {
    // The module always returns JSON. Anything else means Dagger itself failed —
    // an engine error, a missing function, a module that did not build.
    process.stderr.write(out || "dagger produced no output\n")
    process.exit(status === 0 ? EXIT.INFRA : EXIT.INFRA)
  }

  const logPath = record(report)
  if (typeof opts.report === "string") {
    try {
      mkdirSync(dirname(opts.report), { recursive: true })
      writeFileSync(opts.report, JSON.stringify(report, null, 2))
    } catch (err) {
      // The run already happened; losing its summary must not change its verdict.
      process.stderr.write(`could not write ${opts.report}: ${err.message}\n`)
    }
  }
  process.stdout.write(opts.json ? JSON.stringify(report, null, 2) + "\n" : render(report, logPath) + "\n")
  process.exit(report.exitCode ?? (report.ok ? EXIT.OK : EXIT.GATE))
}

main()
