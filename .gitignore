# run reports written by the CLI
.shipkit/

# stage reports collected for the run summary, written by CI
reports/

# generated migration artifacts
ci/*.sql
ci/*.bundle

# dagger
/sdk/
/.dagger/sdk/

# node
node_modules/

# dotnet build output.
#
# Scoped to where .NET projects actually live. A bare `bin/` also matches this repository's
# own bin/, which holds the CLI — and it silently swallowed it for four commits: the kit was
# published without its entry point and its own workflow would have failed on the first run.
**/src/**/bin/
**/src/**/obj/
**/tests/**/bin/
**/tests/**/obj/

# secrets
.env
.env.*
!.env.example
*.key
*.pem

# os
.DS_Store

# local dev-server credentials — generated per machine, never shared
dev-server/.ssh/

# Kamal secrets are never committed. The fixture's is checked in deliberately: it holds
# references to variables, not values, and is the example a client repo copies.
!fixtures/dotnet-api/.kamal/secrets

# Orca/Claude scratch worktrees, never repository content
.claude/worktrees/
